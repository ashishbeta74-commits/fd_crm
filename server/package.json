{
  "name": "crm-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CRM API - Node.js + Express + MongoDB",
  "main": "src/index.js",
  "scripts": {
    "build": "echo \"nothing to build: plain Node API, run npm start\"",
    "dev": "node --watch-path=src --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "db": "node --env-file-if-exists=.env scripts/embedded-mongo.js",
    "sample": "node scripts/make-sample.js",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.js",
    "smoke:features": "node --env-file-if-exists=.env scripts/features-smoke.js",
    "test:unit": "node scripts/writeback-unit.js",
    "import:links": "node --env-file-if-exists=.env scripts/import-links.js",
    "copy-db": "node --env-file-if-exists=.env scripts/copy-db.js"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "mongodb-memory-server": "^10.1.0",
    "mongoose": "^8.9.0",
    "multer": "^2.0.0",
    "nodemailer": "^7.0.13",
    "web-push": "^3.6.7",
    "zod": "^3.24.0"
  }
}

# ---- required ----
# MongoDB Atlas connection string (database "crm"). Locally you can use the embedded DB: mongodb://127.0.0.1:27017/crm
MONGODB_URI=
# Signs session tokens. Optional: leave empty and one is generated once and kept in the database.
# Set it if you want to control it; changing it signs everyone out.
SESSION_SECRET=
# Public URL of the web app (used in push notifications and emails), e.g. https://famousdrive-crm.netlify.app
APP_URL=

# ---- optional ----
PORT=4000
CRM_TIMEZONE=America/New_York
IMPORT_DATE_ORDER=dmy
# Re-import linked Google Sheets every N minutes when their content changed (0 = off)
SHEET_SYNC_MINUTES=30
# Write CRM columns back into linked sheets this often (0 = off)
SHEET_WRITEBACK_SECONDS=60
# Static token that also passes the API auth (for scripts); leave empty to require user logins only
API_TOKEN=

# Outgoing email (Zoho / Gmail app password, or any SMTP)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# or, for Gmail: GMAIL_USER + GMAIL_APP_PASSWORD
SENDER_NAME=
SENDER_PHONE=
COMPANY_NAME=Famous Drive

# Browser push reminders (generate once with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Daily digest time, HH:mm in CRM_TIMEZONE
PUSH_DIGEST_AT=09:00

# Private Google Sheets: a service-account key (JSON string, or a path to the file)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# Skip downloading the embedded MongoDB binary on install (set this on the API host)
MONGOMS_DISABLE_POSTINSTALL=1

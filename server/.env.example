# MongoDB connection string.
# Default points at the embedded MongoDB started by `npm run db` (or `npm run dev` from the repo root).
# For MongoDB Atlas use something like:
# MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/crm
MONGODB_URI=mongodb://127.0.0.1:27017/crm

# API port
PORT=4000

# Embedded MongoDB settings (only used by `npm run db`).
# The data directory is relative to server/ and deliberately lives OUTSIDE server/
# (node --watch restarts the API when anything under server/ changes).
EMBEDDED_MONGO_PORT=27017
EMBEDDED_MONGO_DATA=../.data/mongo

# How to read ambiguous text dates in Excel such as 05/06/2026.
# dmy = 5 June 2026 (default), mdy = May 6 2026. Real Excel date cells are never ambiguous.
IMPORT_DATE_ORDER=dmy

# Check linked Google Sheets every N minutes and re-import only the ones whose content changed
# (0 = off; "Sync now" in the app always works). A linked sheet must be shared as "Anyone with the link" (Viewer).
SHEET_SYNC_MINUTES=1

# Time zone the CRM runs in ("today", 09:00 reminder default, follow-up grouping, exports).
# Applied to the whole API process; the web app renders times in the same zone.
CRM_TIMEZONE=America/New_York

# Two-way Google Sheet sync (optional). A Google Cloud service account key with the Sheets + Drive APIs enabled;
# share each sheet with the account's client_email as Editor. Path is relative to server/. Alternatively GOOGLE_SERVICE_ACCOUNT_JSON.
# GOOGLE_SERVICE_ACCOUNT_FILE=./google-service-account.json
# Seconds to wait after a contact changes before its row is written to the sheet (batches bursts of edits).
SHEET_WRITEBACK_SECONDS=20
# Public URL of the web app, used for the "CRM Link" column written to sheets.
APP_URL=http://localhost:3000

# Browser push notifications (reminders + a daily digest, even when the app is closed).
# Keys are generated automatically and kept in the database; set them here only to pin them.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# New York time for the daily "your day" notification; empty to disable.
PUSH_DIGEST_AT=08:30

# Email sending (optional; without it the CRM opens your mail app with the template filled in).
# Gmail: use an App Password (Google Account -> Security -> 2-Step Verification -> App passwords).
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Any SMTP server instead of Gmail:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@example.com
# SMTP_PASS=secret
# SMTP_FROM="Famous Drive NYC <you@example.com>"
# Merge fields {{senderName}}, {{senderPhone}}, {{companyName}} in email templates:
SENDER_NAME=
SENDER_PHONE=
COMPANY_NAME=Famous Drive NYC

# Sign-in. Sessions are signed with SESSION_SECRET (auto-generated and stored in the database when unset).
# API_TOKEN lets scripts (import-links, smoke tests) call the API without logging in: Authorization: Bearer <API_TOKEN>.
# SESSION_SECRET=
# API_TOKEN=
